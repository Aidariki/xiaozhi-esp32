menu "Ассистент XiaoZhi"

config OTA_URL
    string "URL OTA по умолчанию"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        Приложение обращается по этому URL для проверки новых прошивок и адреса сервера.

choice
    prompt "Прошивка ресурсов (assets)"
    default FLASH_DEFAULT_ASSETS if !USE_EMOTE_MESSAGE_STYLE
    default FLASH_EXPRESSION_ASSETS if USE_EMOTE_MESSAGE_STYLE
    help
        Выберите ресурсы для прошивки в раздел assets.

    config FLASH_NONE_ASSETS
        bool "Не прошивать assets"
    config FLASH_DEFAULT_ASSETS
        bool "Прошить стандартные assets"
        depends on !USE_EMOTE_MESSAGE_STYLE
    config FLASH_CUSTOM_ASSETS
        bool "Прошить пользовательские assets"
    config FLASH_EXPRESSION_ASSETS
        bool "Прошить assets эмоций (Emote)"
        depends on USE_EMOTE_MESSAGE_STYLE
endchoice

config CUSTOM_ASSETS_FILE
    depends on FLASH_CUSTOM_ASSETS
    string "Файл пользовательских assets"
    default "assets.bin"
    help
        Файл пользовательских assets для прошивки.
        Можно указать локальный путь относительно проекта или удалённый URL.

choice
    prompt "Язык интерфейса по умолчанию"
    default LANGUAGE_RU_RU
    help
        Выберите язык отображения на устройстве

