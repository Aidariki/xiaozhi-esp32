choice BOARD_TYPE
    prompt "Целевая плата"
    default BOARD_TYPE_BREAD_COMPACT_ESP32 if IDF_TARGET_ESP32
    default BOARD_TYPE_XMINI_C3_V3 if IDF_TARGET_ESP32C3
    default BOARD_TYPE_ESP_SENSAIRSHUTTLE if IDF_TARGET_ESP32C5
