menu "Ассистент XiaoZhi"

config OTA_URL
    string "URL OTA по умолчанию"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        Приложение обращается по этому URL для проверки новых прошивок и адреса сервера.

choice
    prompt "Прошивка ресурсов (assets)"
    default FLASH_DEFAULT_ASSETS
    help
        Выберите ресурсы для прошивки в раздел assets.

    config FLASH_NONE_ASSETS
        bool "Не прошивать assets"
    config FLASH_DEFAULT_ASSETS
        bool "Прошить стандартные assets"
    config FLASH_CUSTOM_ASSETS
        bool "Прошить пользовательские assets"
endchoice

config CUSTOM_ASSETS_FILE
    depends on FLASH_CUSTOM_ASSETS
    string "Файл пользовательских assets"
    default "assets.bin"
    help
        Файл пользовательских assets для прошивки.
        Можно указать локальный путь относительно проекта или удалённый URL.

choice
    prompt "Язык интерфейса по умолчанию"
    default LANGUAGE_RU_RU
    help
        Выберите язык отображения на устройстве

    config LANGUAGE_ZH_CN
        bool "Китайский (упрощённый)"
    config LANGUAGE_ZH_TW
        bool "Китайский (традиционный)"
    config LANGUAGE_EN_US
        bool "Английский"
    config LANGUAGE_JA_JP
        bool "Японский"
    config LANGUAGE_KO_KR
        bool "Корейский"
    config LANGUAGE_VI_VN
        bool "Вьетнамский"
    config LANGUAGE_TH_TH
        bool "Тайский"
    config LANGUAGE_DE_DE
        bool "Немецкий"
    config LANGUAGE_FR_FR
        bool "Французский"
    config LANGUAGE_ES_ES
        bool "Испанский"
    config LANGUAGE_IT_IT
        bool "Итальянский"
    config LANGUAGE_RU_RU
        bool "Русский"
    config LANGUAGE_AR_SA
        bool "Арабский"
    config LANGUAGE_HI_IN
        bool "Хинди"
    config LANGUAGE_PT_PT
        bool "Португальский"
    config LANGUAGE_PL_PL
        bool "Польский"
    config LANGUAGE_CS_CZ
        bool "Чешский"
    config LANGUAGE_FI_FI
        bool "Финский"
    config LANGUAGE_TR_TR
        bool "Турецкий"
    config LANGUAGE_ID_ID
        bool "Индонезийский"
    config LANGUAGE_UK_UA
        bool "Украинский"
    config LANGUAGE_RO_RO
        bool "Румынский"
    config LANGUAGE_BG_BG
        bool "Болгарский"
    config LANGUAGE_CA_ES
        bool "Каталанский"
    config LANGUAGE_DA_DK
        bool "Датский"
    config LANGUAGE_EL_GR
        bool "Греческий"
    config LANGUAGE_FA_IR
        bool "Персидский"
    config LANGUAGE_FIL_PH
        bool "Филиппинский"
    config LANGUAGE_HE_IL
        bool "Иврит"
    config LANGUAGE_HR_HR
        bool "Хорватский"
    config LANGUAGE_HU_HU
        bool "Венгерский"
    config LANGUAGE_MS_MY
        bool "Малайский"
    config LANGUAGE_NB_NO
        bool "Норвежский"
    config LANGUAGE_NL_NL
        bool "Нидерландский"
    config LANGUAGE_SK_SK
        bool "Словацкий"
    config LANGUAGE_SL_SI
        bool "Словенский"
    config LANGUAGE_SV_SE
        bool "Шведский"
    config LANGUAGE_SR_RS
        bool "Сербский"
endchoice

choice BOARD_TYPE
    prompt "Целевая плата"
    help
        Поддерживается только плата Guition JC1060P470C (ESP32-P4).
        Тип платы для OTA и имя варианта прошивки задаются в config.json.
    default BOARD_TYPE_GUITION_JC1060P470 if IDF_TARGET_ESP32P4
    config BOARD_TYPE_GUITION_JC1060P470
        bool "Guition JC1060P470C (ESP32-P4)"
endchoice

choice DISPLAY_STYLE
    prompt "Стиль отображения сообщений"
    default USE_DEFAULT_MESSAGE_STYLE
    help
        Выберите стиль отображения сообщений на устройстве XiaoZhi

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Стандартный стиль сообщений"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Стиль сообщений WeChat"

endchoice

menu "Интерактивные глаза (JC1060P470C)"

choice EYES_TYPE
    prompt "Облик интерактивных глаз"
    default EYES_TYPE_STANDARD
    depends on BOARD_TYPE_GUITION_JC1060P470
    help
        Выберите вариант анимированных «глаз» ассистента на экране.
        Варианты собраны из популярных реализаций сообщества
        (xiaozhi-esp32, M5Stack CoreS3 eyes, LVGL EYES example,
        xiaozhi-esp32-lcd-example/kawaii, ESP32 robot-глаза).
        Выбор можно переключить в любой момент кнопкой BOOT
        (короткое нажатие) — новый облик сохранится в настройках.

    config EYES_TYPE_STANDARD
        bool "Стандартный (эмодзи и иконки Material Symbols)"
        help
            Штатный облик XiaoZhi: крупный эмодзи/иконка настроения
            по центру экрана. Никаких дополнительных объектов LVGL.

    config EYES_TYPE_CLASSIC
        bool "Классические круглые глаза (стиль M5Stack CoreS3)"
        help
            Два белых круга с тёмной окантовкой и цветным зрачком.
            Зрачок меняет размер и положение по настроению,
            периодическое моргание «веком».

    config EYES_TYPE_ROBOT
        bool "Робот-глаза (широкие визоры, стиль ESP32-роботов)"
        help
            Прямоугольные «визоры» на чёрной подложке со светящейся
            щелевидной зрачкой-полосой. Цвет полосы зависит от
            настроения (синий/жёлтый/красный/серый).

    config EYES_TYPE_PIXEL
        bool "Пиксельные глаза (ретро 8-bit)"
        help
            Квадратные глаза с зелёной неоновой рамкой в стиле
            пиксельной графики. Моргание выполняется мгновенной
            «засветкой» всего глаза.

    config EYES_TYPE_ANIME
        bool "Аниме-глаза (с ресницами и бликами)"
        help
            Большие выразительные глаза с фиолетовой радужкой,
            белым бликом и тремя ресницами сверху. Стиль примера
            LVGL «EYES».

    config EYES_TYPE_KAWAII
        bool "Каваи-глаза (arco-стиль, градиентные)"
        help
            Круглые глаза с вертикальным градиентом цвета настроения
            и маленьким чёрным зрачком. Милый минималистичный стиль
            из клона xiaozhi-esp32-lcd-example.

endchoice

# Числовой идентификатор выбранного облика (используется кодом платы
# для отображения названия варианта при переключении кнопкой BOOT).
config EYES_TYPE_ID_DEFAULT
    int
    depends on BOARD_TYPE_GUITION_JC1060P470
    default 0 if EYES_TYPE_STANDARD
    default 1 if EYES_TYPE_CLASSIC
    default 2 if EYES_TYPE_ROBOT
    default 3 if EYES_TYPE_PIXEL
    default 4 if EYES_TYPE_ANIME
    default 5 if EYES_TYPE_KAWAII
    default 0

config EYES_BLINK_INTERVAL_MS
    int "Интервал моргания, мс"
    depends on BOARD_TYPE_GUITION_JC1060P470 && !EYES_TYPE_STANDARD
    range 1000 20000
    default 4000
    help
        Как часто глаза будут моргать в выбранном облике.
        Меньше значение — чаще моргание (выглядит «живее»,
        но чуть больше нагрузки на LVGL-таймеры).

endmenu

config USE_MULTILINE_CHAT_MESSAGE
    bool "Многострочный чат (только стандартный режим)"
    depends on USE_DEFAULT_MESSAGE_STYLE
    default n
    help
        Если включено, область чата в стандартном режиме показывает несколько
        переносимых строк, растущих вверх от нижнего края экрана
        (высота подстраивается автоматически).
        Если выключено (по умолчанию) — одна строка с горизонтальной прокруткой
        внизу экрана.

choice WAKE_WORD_TYPE
    prompt "Реализация слова активации"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Выберите способ реализации слова активации

    config WAKE_WORD_DISABLED
        bool "Отключено"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Модель Wakenet без AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Модель Wakenet с AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Support AEC if available, requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Модель Multinet (своё слово активации)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Своё слово активации"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Своё слово активации; для китайского — пиньинь через пробел

config CUSTOM_WAKE_WORD_DISPLAY
    string "Отображение слова активации"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Приветствие, отправляемое на сервер после обнаружения слова активации

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Порог слова активации (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Порог слова активации (1–99); чем меньше, тем чувствительнее; по умолчанию 20

config SEND_WAKE_WORD_DATA
    bool "Отправлять данные слова активации"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Отправлять данные слова активации на сервер как первое сообщение диалога и ждать ответа

config WAKE_WORD_DETECTION_IN_LISTENING
    bool "Распознавание слова активации в режиме прослушивания"
    default n
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Распознавать слово активации в режиме прослушивания.
        Позволяет прервать текущий диалог словом активации.
        Если выключено (по умолчанию) — в режиме прослушивания детекция отключена.

config USE_AUDIO_PROCESSOR
    bool "Обработка звука AFE"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    help
        Общий uplink-путь AFE с AEC и VAD. Подавление шума не включается —
        в проекте нет модели NSNet.
        Требуется ESP32-S3, ESP32-P4 или ESP32-S31 с PSRAM.

config USE_DEVICE_AEC
    bool "AEC на устройстве"
    default n
    depends on BOARD_TYPE_GUITION_JC1060P470
    help
        Для корректной работы AEC на устройстве нужен чистый опорный сигнал с динамика
        и акустическая развязка динамика и микрофона.
        Включить отладчик аудио: отправка аудиоданных по UDP на ПК

menu "Способ настройки Wi-Fi"
    help
        Выбор способа настройки Wi-Fi
    config USE_HOTSPOT_WIFI_PROVISIONING
        bool "Точка доступа (Hotspot)"
        default y
        help
            Use WiFi Hotspot to transmit WiFi configuration data
    config USE_ESP_BLUFI_WIFI_PROVISIONING
        bool "ESP-BluFi"
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        select BT_BLE_BLUFI_ENABLE
        help
            Use the PSA Crypto based BluFi security protocol adopted by ESP-IDF 6.
            The provisioning client must support ffdhe3072, SHA-256, and AES-CTR.
endmenu

config AUDIO_DEBUG_UDP_SERVER
    string "UDP-адрес сервера отладки аудио"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        Адрес UDP-сервера в формате IP:PORT для приёма отладочных аудиоданных

config RECEIVE_CUSTOM_MESSAGE
    bool "Приём пользовательских сообщений"
    default n
    help
        Приём пользовательских сообщений с сервера (предпочтительно по MQTT)

menu "Настройка камеры"
    depends on !IDF_TARGET_ESP32

    comment "Warning: Please read the help text before modifying these settings."

    config XIAOZHI_CAMERA_MIRROR_CONFIGURED
        bool "Переопределить зеркалирование камеры"
        default n
        help
            Если включено, общие реализации камеры применяют зеркалирование
            по горизонтали/вертикали после инициализации сенсора.
            Параметризованные сборки включают это автоматически,
            если задано любое зеркалирование.

    config XIAOZHI_CAMERA_HMIRROR
        bool "Зеркало по горизонтали"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Отразить кадр камеры по вертикальной оси.

    config XIAOZHI_CAMERA_VFLIP
        bool "Зеркало по вертикали"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Отразить кадр камеры по горизонтальной оси.

    config XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        bool "Разрешить вход JPEG"
        default n
        help
            Разрешить формат JPEG на входе камеры.

            This option may need to be enabled when using a USB camera.

            Not currently supported when used simultaneously with XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Аппаратный JPEG-кодировщик"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Аппаратный JPEG-кодировщик ESP32-P4. См. документацию ESP-IDF по JPEG.
endmenu

endmenu
